DATABASE_URL=postgresql://mountain:mountain123@localhost:5432/mountain_db
BITRIX_WEBHOOK_URL=https://your-domain.bitrix24.com/rest/1/your-webhook-token
PORT=3001
MAIN_RESPONSIBLE_ID=1

# OnlinePBX call statistics (Call statistikasi page). The PBX has no webhooks,
# so calls are pulled on an interval. Leave unset to disable call sync.
# API key: OnlinePBX panel → Settings → API.
ONPBX_DOMAIN=your-pbx.onpbx.ru
ONPBX_API_KEY=your-onlinepbx-api-key
CALL_SYNC_INTERVAL_MIN=5
CALL_SYNC_LOOKBACK_HOURS=3
CALL_SYNC_BACKFILL_DAYS=45

# Google Sheets → Bitrix lead yaratish (har daqiqada).
# SHEETS_LEADS_ID bo'sh bo'lsa — sync o'chiq.
# Varaq service-account pochtasiga "Editor" qilib ulashilgan bo'lishi kerak.
GOOGLE_CREDENTIALS_PATH=./google-credentials.json
SHEETS_LEADS_ID=11q1M1vnN6u8S7dVvZqHMKg2XJcQDFvPgnBh-NRI7UIM
SHEETS_LEADS_TAB=Leads
SHEETS_LEADS_INTERVAL_SEC=60
SHEETS_LEADS_DEDUPE_PHONE=true
SHEETS_LEADS_STATUS_ID=IN_PROCESS
SHEETS_LEADS_SOURCE_ID=READY_UZ
